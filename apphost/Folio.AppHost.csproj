<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>2403bb9c-e857-439d-9601-4ba35b15e12c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
    <!-- StreamJsonRpc's transitive minimum has known MessagePack vulnerabilities. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
    <ProjectReference Include="../backend/Folio.Api/Folio.Api.csproj" />
  </ItemGroup>

</Project>
